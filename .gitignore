.venv/
__pycache__/
*.pyc
.pytest_cache/

# runtime output directories at the repo root only - the leading slash matters:
# a bare "events/" would also ignore visionguard/camera/events/ (the source package)
/logs/
/events/
/models/*.pt
/config/*.tmp

# Build artefacts - the bundle is ~900 MB and the installer ~380 MB
/build/venv/
/build/dist/
/build/work/
/build/staging/
/build/payload.zip
/release/
