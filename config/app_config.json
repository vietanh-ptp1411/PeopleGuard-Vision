{
  "log_level": "INFO",
  "events_db_path": "events/events.db",
  "ui_fps_limit": 30,
  "snapshot": {
    "enabled": true,
    "directory": "events",
    "jpeg_quality": 90
  },
  "clip": {
    "enabled": false,
    "directory": "events/clips",
    "pre_roll_s": 2.0,
    "post_roll_s": 2.0,
    "max_duration_s": 120.0,
    "fps": 0.0,
    "scale": 0.5,
    "retention_days": 14,
    "max_total_gb": 20.0
  },
  "retention": {
    "event_days": 90,
    "event_max_rows": 200000,
    "snapshot_days": 30,
    "log_days": 30,
    "log_dir": "logs",
    "interval_hours": 6.0
  },
  "visualization": {
    "color_roi_include": "#FFD400",
    "color_roi_include_occupied": "#FF3B30",
    "color_roi_exclude": "#8E8E93",
    "color_roi_editing": "#00C7FF",
    "color_person": "#34C759",
    "color_person_in_roi": "#FF3B30",
    "color_person_ignored": "#8E8E93",
    "color_point": "#FFFFFF",
    "line_width": 2,
    "show_confidence": true,
    "show_ids": true,
    "show_points": true,
    "show_labels": true
  },
  "autostart": true,
  "autostart_timeout_s": 25.0
}